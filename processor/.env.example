# Incoming Processor configuration. Copy this file to ".env".

# REQUIRED: root folder of your archive on the Docker host. Below it live
# incoming/, scenereleases/, scenereleases_srr/, scenereleases_nosrr/ etc.
# Must be a local folder (no SMB/CIFS share) because of the symlinks.
ARCHIVE_PATH=/srv/archive

# Where the logs are written
LOG_PATH=./logs

# Cache of the genre statistics (only used by the nightly pipeline)
STATE_PATH=./state

# 1 = preview only, nothing is moved or renamed
DRY_RUN=0

# Seconds between two srrDB requests
REQUEST_DELAY=1.0

# OPTIONAL: reindex ArchiveDB after every run,
# e.g. http://archivedb:8000 (both containers in the same Docker network)
ARCHIVEDB_URL=

# OPTIONAL: run report to a Discord channel
# (channel > settings > integrations > webhooks > copy URL).
# This URL is a secret. Do not commit it to Git, .env is excluded.
DISCORD_WEBHOOK_URL=
# 1 = do not send a report when there was nothing to process
DISCORD_SKIP_EMPTY_RUNS=1

# OPTIONAL: HTTP proxy (e.g. gluetun) that is only used after srrDB has
# blocked your own IP (HTTP 403/429/503). Empty = no proxy.
VPN_PROXY_URL=
