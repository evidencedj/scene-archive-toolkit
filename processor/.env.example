# Incoming Processor Konfiguration. Kopiere diese Datei nach ".env".

# PFLICHT: Wurzelordner deines Archivs auf dem Docker Host. Darunter liegen
# incoming/, scenereleases/, scenereleases_srr/, scenereleases_nosrr/ usw.
# Muss ein lokaler Ordner sein (kein SMB/CIFS Laufwerk), wegen der Symlinks.
ARCHIVE_PATH=/srv/archive

# Wohin die Protokolle geschrieben werden
LOG_PATH=./logs

# 1 = nur Vorschau, nichts wird verschoben oder umbenannt
DRY_RUN=0

# Sekunden zwischen zwei srrDB Anfragen
REQUEST_DELAY=1.0

# OPTIONAL: Nach jedem Lauf die ArchiveDB neu indexieren,
# z.B. http://archivedb:8000 (beide Container im selben Docker Netzwerk)
ARCHIVEDB_URL=

# OPTIONAL: Laufbericht in einen Discord Kanal
# (Kanal > Einstellungen > Integrationen > Webhooks > URL kopieren).
# Diese URL ist ein Geheimnis. Nicht ins Git einchecken, .env ist ausgeschlossen.
DISCORD_WEBHOOK_URL=
# 1 = keinen Bericht senden, wenn nichts zu verarbeiten war
DISCORD_SKIP_EMPTY_RUNS=1

# OPTIONAL: HTTP Proxy (z.B. gluetun), der erst benutzt wird, nachdem srrDB
# die eigene IP gesperrt hat (HTTP 403/429/503). Leer = kein Proxy.
VPN_PROXY_URL=
