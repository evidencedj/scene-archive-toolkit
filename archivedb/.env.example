# ArchiveDB Konfiguration. Kopiere diese Datei nach ".env" und passe sie an.

# PFLICHT: Wurzelordner deines Archivs auf dem Docker Host. Darunter muessen
# die Ordner scenereleases_srr und scenereleases_nosrr liegen.
ARCHIVE_PATH=/srv/archive

# Port, unter dem die Oberflaeche erreichbar ist (http://<host>:8000)
ARCHIVEDB_PORT=8000

# Ordnernamen unter ARCHIVE_PATH (nur aendern, wenn deine anders heissen)
SRR_FOLDER=scenereleases_srr
NOSRR_FOLDER=scenereleases_nosrr

# OPTIONAL: Button "Open in Storagebox" (Weboberflaeche index.html auf einer
# Hetzner Storage Box oder einem anderen Webserver). Leer lassen = kein Button.
# Beispiel: https://uXXXXXXX.your-storagebox.de/index.html#
FILES_BASE_URL=
FILES_FOLDER=scenereleases_srr
FILES_FOLDER_NOSRR=scenereleases_nosrr

# OPTIONAL: Windows Freigabe fuer "Open in Explorer" und "Copy folder path".
# Leer lassen = beide Knoepfe entfallen. Backslashes in .env doppelt schreiben:
# UNC_BASE_PATH=\\\\server\\share\\scenereleases_srr
UNC_BASE_PATH=
