# ArchiveDB configuration. Copy this file to ".env" and adjust it.

# REQUIRED: root folder of your archive on the Docker host. Below it the folders
# scenereleases_srr and scenereleases_nosrr must exist.
ARCHIVE_PATH=/srv/archive

# Port the web UI is served on (http://<host>:8000)
ARCHIVEDB_PORT=8000

# Folder names below ARCHIVE_PATH (only change them if yours are named differently)
SRR_FOLDER=scenereleases_srr
NOSRR_FOLDER=scenereleases_nosrr

# OPTIONAL: "Open in Storagebox" button (web UI index.html on a Hetzner
# Storage Box or any other web server). Leave empty = no button.
# Example: https://uXXXXXXX.your-storagebox.de/index.html#
FILES_BASE_URL=
FILES_FOLDER=scenereleases_srr
FILES_FOLDER_NOSRR=scenereleases_nosrr

# OPTIONAL: Windows share for "Open in Explorer" and "Copy folder path".
# Leave empty = both buttons are hidden. Write backslashes twice in .env:
# UNC_BASE_PATH=\\\\server\\share\\scenereleases_srr
UNC_BASE_PATH=
