# Einstellungen der Nachtpipeline. Kopiere diese Datei nach "pipeline.env".
# Die Datei wird von scene_nightly.sh, run_incoming_processor.sh und
# wait_for_processor.sh eingelesen (bash Syntax, keine Leerzeichen um das "=").

# PFLICHT: Wurzelordner deines Archivs auf dem Host (derselbe wie ARCHIVE_PATH
# in processor/.env). Muss ein lokaler Ordner sein.
ARCHIVE=/srv/archive

# Ordner mit docker-compose.yml und .env des Processors (Standard: ../processor)
#PROCESSOR_DIR=/srv/scene-archive-toolkit/processor

# Wohin die Pipeline Status, Sperre und Protokolle schreibt (Standard: ./state)
#STATE_DIR=/srv/scene-archive-toolkit/pipeline/state

# Docker Compose Aufruf: "docker compose" (Plugin) oder "docker-compose" (alt)
#COMPOSE_CMD="docker compose"

# OPTIONAL: Zusammenfassung jeder Nacht in einen Discord Kanal (Webhook URL).
# Die URL ist ein Geheimnis, pipeline.env gehoert nicht ins Git.
DISCORD_WEBHOOK_URL=

# OPTIONAL: eigenes Skript fuer den Schritt "mirror" (z.B. eine Kopie des Archivs
# auf einen zweiten Rechner und ein Reindex der ArchiveDB). Rueckgabe 0 = ok,
# 2 = ok mit Hinweis, sonst Fehler. Leer = Schritt wird uebersprungen.
MIRROR_SCRIPT=

# OPTIONAL: Skript, das nach jedem Nachtlauf startet (z.B. Backup oder Herunterfahren).
# Es bekommt das Ergebnis als Argument: OK, "MIT HINWEISEN", FEHLER.
#AFTER_HOOK=/srv/scene-archive-toolkit/pipeline/after_pipeline.sh

# Wie viele Minuten die Pipeline auf einen laufenden Hand Lauf des Processors wartet
#LOCK_WAIT_MIN=120

# Schutz vor einem nicht eingebundenen Laufwerk: scenereleases_srr muss mindestens
# so viele Eintraege haben, sonst bricht die Pipeline ab. 0 = nur pruefen, dass der Ordner da ist.
#MIN_ENTRIES=0

# OPTIONAL: Unraid Benachrichtigung (Pfad zum notify Skript). Auf anderen Systemen leer lassen.
#NOTIFY=/usr/local/emhttp/webGui/scripts/notify
#NOTIFY_ON_OK=0

# Wie viele Tage Protokolle aufbewahrt werden
#LOG_KEEP_DAYS=30
