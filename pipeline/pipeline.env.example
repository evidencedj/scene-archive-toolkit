# Settings of the nightly pipeline. Copy this file to "pipeline.env".
# The file is read by scene_nightly.sh, run_incoming_processor.sh and
# wait_for_processor.sh (bash syntax, no spaces around the "=").

# REQUIRED: root folder of your archive on the host (the same as ARCHIVE_PATH
# in processor/.env). Must be a local folder.
ARCHIVE=/srv/archive

# Folder with the processor's docker-compose.yml and .env (default: ../processor)
#PROCESSOR_DIR=/srv/scene-archive-toolkit/processor

# Where the pipeline writes state, lock and logs (default: ./state)
#STATE_DIR=/srv/scene-archive-toolkit/pipeline/state

# Docker Compose call: "docker compose" (plugin) or "docker-compose" (old)
#COMPOSE_CMD="docker compose"

# OPTIONAL: summary of every night in a Discord channel (webhook URL).
# The URL is a secret, pipeline.env must not go into Git.
DISCORD_WEBHOOK_URL=

# OPTIONAL: your own script for the step "mirror" (e.g. a copy of the archive
# to a second machine and a reindex of ArchiveDB). Return code 0 = ok,
# 2 = ok with a warning, anything else = error. Empty = the step is skipped.
MIRROR_SCRIPT=

# OPTIONAL: script that starts after every nightly run (e.g. backup or shutdown).
# It receives the result as an argument: OK, "WITH WARNINGS", ERROR.
#AFTER_HOOK=/srv/scene-archive-toolkit/pipeline/after_pipeline.sh

# How many minutes the pipeline waits for a running manual processor run
#LOCK_WAIT_MIN=120

# Protection against an unmounted drive: scenereleases_srr must have at least
# this many entries, otherwise the pipeline aborts. 0 = only check that the folder exists.
#MIN_ENTRIES=0

# OPTIONAL: Unraid notification (path to the notify script). Leave empty on other systems.
#NOTIFY=/usr/local/emhttp/webGui/scripts/notify
#NOTIFY_ON_OK=0

# How many days logs are kept
#LOG_KEEP_DAYS=30
